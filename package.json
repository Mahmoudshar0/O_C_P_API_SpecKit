{
  "name": "online-course-platform-backend",
  "version": "0.1.0",
  "description": "REST API backend for Online Course Platform",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --watch",
    "test:ci": "jest --coverage --verbose",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "jwt",
    "rest-api",
    "education"
  ],
  "author": "Online Course Platform Team",
  "license": "Proprietary",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.0",
    "dotenv": "^16.0.3",
    "jsonwebtoken": "^9.0.0",
    "joi": "^17.9.1",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.20",
    "eslint": "^8.36.0",
    "prettier": "^2.8.4",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
